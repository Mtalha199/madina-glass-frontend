    {
        label,
        id,
        type,
        placeholder,
        value,
        onChange,
        ...props
    }) => {
    return (
        <>
            <Label htmlFor="email">{label}</Label>
            <Input
                id={id}
                type={type}
                placeholder={placeholder}
                value={value}
                onChange={onChange}
                {...props}
            />
        </>
    )
